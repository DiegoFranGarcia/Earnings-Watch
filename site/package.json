{
  "name": "earningswatch-site",
  "private": true,
  "description": "The EarningsWatch public site: a static SvelteKit app built from the pipeline's export (ADR 17, ADR 19).",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "node scripts/fetch-duckdb-extensions.mjs && vite build && node scripts/sql-csp.mjs build",
    "check": "svelte-kit sync && svelte-check --threshold warning",
    "serve": "node tests/serve.mjs",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "echarts": "6.1.0",
    "fzstd": "0.1.1",
    "hyparquet": "1.32.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}

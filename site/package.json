{
  "name": "earningswatch-site",
  "private": true,
  "description": "The EarningsWatch public site: a static SvelteKit app built from the pipeline's export (ADR 17, ADR 19).",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --threshold warning",
    "serve": "node tests/serve.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "hyparquet": "1.32.0",
    "hyparquet-compressors": "1.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}

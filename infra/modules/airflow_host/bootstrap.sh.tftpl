#!/bin/bash
# EarningsWatch Airflow host: first-boot bootstrap. Rendered by Terraform; contains no secrets
# (they are fetched into memory on every start). Its log: /var/log/earningswatch-bootstrap.log
set -euxo pipefail
exec > >(tee -a /var/log/earningswatch-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker

# Docker Compose plugin: a pinned release, verified against a checksum pinned in the repository.
mkdir -p /usr/local/lib/docker/cli-plugins
plugin=/usr/local/lib/docker/cli-plugins/docker-compose
curl -fsSL -o "$plugin" \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64"
echo "${compose_sha256}  $plugin" | sha256sum -c -
chmod 755 "$plugin"

mkdir -p /opt/earningswatch/logs /opt/earningswatch/deploy
chown 50000:0 /opt/earningswatch/logs

# Non-secret settings, fixed for the life of this host.
cat > /opt/earningswatch/settings.env <<'SETTINGS'
LAKE_BUCKET=${lake_bucket}
EMR_APPLICATION_ID=${emr_application_id}
EMR_JOB_ROLE_ARN=${emr_job_role_arn}
SF_ACCOUNT=${snowflake_account}
SF_DATABASE=${snowflake_database}
SF_USER=SVC_AIRFLOW
SF_PRIVATE_KEY_PATH=/opt/airflow/keys/svc_airflow_rsa_key.p8
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/svc_dbt_rsa_key.p8
EARNINGSWATCH_HOME=/opt/earningswatch
KEYS_DIR=/run/earningswatch/keys
ENV_FILE_PATH=/run/earningswatch/airflow.env
RELEASE_URI=s3://${lake_bucket}/artifacts/releases/current.env
ECR_REPOSITORY=${ecr_repository_url}
SETTINGS

# The current release: changed by earningswatch-deploy, read on every start.
cat > /opt/earningswatch/release.env <<'RELEASE'
AIRFLOW_IMAGE=${image}
SPARK_CODE_URI=${spark_code_uri}
RELEASE

cat > /usr/local/bin/earningswatch-start <<'START'
#!/bin/bash
# Start (or restart) Airflow with the current release.
#
# 1. Secrets from Secrets Manager into memory (/run): never written to disk.
# 2. The release (image and Spark code) from S3, published by CI on every merge to main. It is
#    parsed, never executed, and accepted only if the image is this host's own registry and the
#    Spark code is in this lake. If S3 cannot be read, the last release started here is used.
# 3. The Compose file from inside the image, so image and Compose file always match.
# 4. If the release fails to start, the last release that did is started instead, and Discord is
#    told. A deploy then fails too: the host is not running the current release.
set -euo pipefail
home=/opt/earningswatch
run=/run/earningswatch
source "$home/settings.env"

secret() {
  aws secretsmanager get-secret-value --region us-east-1 \
    --secret-id "earningswatch/${env}/$1" --query SecretString --output text
}

# Best effort: a failed alert must never stop a start. The URL comes from Secrets Manager, so an
# alert works at any point, even before airflow.env is written.
alert() {
  echo "$1" >&2
  local url
  url=$(secret discord-webhook-url 2>/dev/null || true)
  if [ -n "$url" ]; then
    python3 -c 'import json, sys; print(json.dumps({"content": sys.argv[1]}))' "$1" \
      | curl -fsS -m 10 -H 'Content-Type: application/json' -d @- "$url" >/dev/null || true
  fi
}

# Read a release file without executing it; print "image spark" if both values are acceptable.
parse_release() {
  local image spark tag
  image=$(sed -n 's/^AIRFLOW_IMAGE=//p' "$1" | head -1)
  spark=$(sed -n 's/^SPARK_CODE_URI=//p' "$1" | head -1)
  tag=$(echo "$image" | sed "s|^$ECR_REPOSITORY:||")
  if [[ ! "$tag" =~ ^[0-9a-f]{12}$ ]] || [ "$image" != "$ECR_REPOSITORY:$tag" ]; then
    echo "not this host's registry, or not a commit tag: $image" >&2
    return 1
  fi
  tag=$(echo "$spark" | sed "s|^s3://$LAKE_BUCKET/artifacts/spark/||")
  if [[ ! "$tag" =~ ^[0-9a-f]{12}$ ]] || [ "$spark" != "s3://$LAKE_BUCKET/artifacts/spark/$tag" ]; then
    echo "not this lake's Spark code: $spark" >&2
    return 1
  fi
  echo "$image $spark"
}

write_release() {
  printf 'AIRFLOW_IMAGE=%s\nSPARK_CODE_URI=%s\n' "$1" "$2" > "$home/release.env.new"
  mv "$home/release.env.new" "$home/release.env"
}

# The release CI published, if it can be read and is acceptable; otherwise the current one stays.
fetch_release() {
  local file values
  file=$(mktemp)
  if ! aws s3 cp --only-show-errors "$RELEASE_URI" "$file" 2>/dev/null; then
    echo "could not read $RELEASE_URI; keeping the last release" >&2
  elif values=$(parse_release "$file"); then
    write_release $values # two words: the image and the Spark code
  else
    alert "⚠️ Airflow host: ignored an invalid release at $RELEASE_URI"
  fi
  rm -f "$file"
}

write_env() {
  {
    cat "$home/settings.env"
    echo "AIRFLOW_IMAGE=$AIRFLOW_IMAGE"
    echo "SPARK_CODE_URI=$SPARK_CODE_URI"
    echo "DISCORD_WEBHOOK_URL=$(secret discord-webhook-url)"
    secret airflow-internals \
      | python3 -c 'import json, sys; [print(k + "=" + v) for k, v in json.load(sys.stdin).items()]'
  } > "$run/airflow.env"
}

start_release() {
  source "$home/release.env"
  write_env
  aws ecr get-login-password --region us-east-1 \
    | docker login --username AWS --password-stdin "$(echo "$ECR_REPOSITORY" | cut -d/ -f1)"
  docker pull --quiet "$AIRFLOW_IMAGE"
  docker run --rm --entrypoint cat "$AIRFLOW_IMAGE" /opt/airflow/deploy/compose.yaml \
    > "$home/deploy/compose.yaml"
  docker compose -p earningswatch -f "$home/deploy/compose.yaml" --env-file "$run/airflow.env" \
    up -d --remove-orphans --wait --wait-timeout 600
}

# /run is in memory: nothing below is ever written to disk.
umask 077
mkdir -p "$run"
install -d -m 0750 -o 50000 -g 0 "$run/keys"
secret svc-airflow-private-key > "$run/keys/svc_airflow_rsa_key.p8"
secret svc-dbt-private-key > "$run/keys/svc_dbt_rsa_key.p8"
chown 50000:0 "$run"/keys/*.p8
chmod 0400 "$run"/keys/*.p8

fetch_release
if start_release; then
  cp "$home/release.env" "$home/release.good"
  echo "running $AIRFLOW_IMAGE"
  exit 0
fi

failed=$AIRFLOW_IMAGE
if [ -f "$home/release.good" ] && ! cmp -s "$home/release.env" "$home/release.good"; then
  cp "$home/release.good" "$home/release.env"
  if start_release; then
    alert "⚠️ Airflow host: $failed failed to start; rolled back to $AIRFLOW_IMAGE"
    exit 0
  fi
fi
alert "❌ Airflow host: could not start $failed, and no earlier release started either"
exit 1
START

cat > /usr/local/bin/earningswatch-deploy <<'DEPLOY'
#!/bin/bash
# Deploy the current release now: restart, which fetches and starts it. Succeeds only if the host
# ends up running exactly the release published at RELEASE_URI; a rolled-back start is a failure.
set -euo pipefail
source /opt/earningswatch/settings.env
expected=$(aws s3 cp --only-show-errors "$RELEASE_URI" - | sed -n 's/^AIRFLOW_IMAGE=//p' | head -1)
if [ -z "$expected" ]; then
  echo "no release published at $RELEASE_URI" >&2
  exit 1
fi
systemctl restart earningswatch.service || true
source /opt/earningswatch/release.env
if [ "$(systemctl is-active earningswatch)" = active ] && [ "$AIRFLOW_IMAGE" = "$expected" ]; then
  echo "deployed $expected"
  exit 0
fi
echo "deploy of $expected failed: the host is running $AIRFLOW_IMAGE" >&2
exit 1
DEPLOY

cat > /usr/local/bin/earningswatch-backup <<'BACKUP'
#!/bin/bash
# Back up Airflow's metadata database to S3: a dated copy, and latest.sql.gz for a rebuild.
set -euo pipefail
source /opt/earningswatch/settings.env
day=$(date -u +%F)
dump=$(mktemp)
docker exec earningswatch-postgres-1 pg_dump -U airflow --clean --if-exists airflow | gzip > "$dump"
aws s3 cp --only-show-errors "$dump" "s3://$LAKE_BUCKET/airflow/backups/airflow-$day.sql.gz"
aws s3 cp --only-show-errors "$dump" "s3://$LAKE_BUCKET/airflow/backups/latest.sql.gz"
echo "backed up $(stat -c %s "$dump") bytes to s3://$LAKE_BUCKET/airflow/backups/airflow-$day.sql.gz"
rm -f "$dump"
BACKUP

cat > /usr/local/bin/earningswatch-restore <<'RESTORE'
#!/bin/bash
# Restore Airflow's metadata database from S3, then restart Airflow with its history back.
#   earningswatch-restore                            (latest.sql.gz)
#   earningswatch-restore airflow-2026-11-13.sql.gz  (a dated backup)
set -euo pipefail
source /opt/earningswatch/settings.env
name=latest.sql.gz
if [ $# -ge 1 ]; then name="$1"; fi
dump=$(mktemp)
aws s3 cp --only-show-errors "s3://$LAKE_BUCKET/airflow/backups/$name" "$dump"
# Stop everything that writes to the database; keep the database itself running.
docker compose -p earningswatch -f /opt/earningswatch/deploy/compose.yaml \
  --env-file /run/earningswatch/airflow.env \
  stop airflow-apiserver airflow-scheduler airflow-dag-processor airflow-triggerer
# The backup drops and recreates every table (pg_dump --clean --if-exists). Stop at the first
# error rather than leave a half-restored database.
gunzip -c "$dump" \
  | docker exec -i earningswatch-postgres-1 psql -U airflow -d airflow -v ON_ERROR_STOP=1 --quiet
rm -f "$dump"
systemctl restart earningswatch.service
echo "restored $name"
RESTORE

chmod 755 /usr/local/bin/earningswatch-start /usr/local/bin/earningswatch-deploy \
  /usr/local/bin/earningswatch-backup /usr/local/bin/earningswatch-restore

cat > /etc/systemd/system/earningswatch-backup.service <<'BACKUPSERVICE'
[Unit]
Description=Back up the EarningsWatch Airflow database to S3
Requires=earningswatch.service
After=earningswatch.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/earningswatch-backup
BACKUPSERVICE

# 09:30 UTC: inside the host's daily window (05:45 to 09:45), after the daily DAGs.
cat > /etc/systemd/system/earningswatch-backup.timer <<'BACKUPTIMER'
[Unit]
Description=Back up the EarningsWatch Airflow database daily

[Timer]
OnCalendar=*-*-* 09:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
BACKUPTIMER

cat > /etc/systemd/system/earningswatch.service <<'UNIT'
[Unit]
Description=EarningsWatch Airflow
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The instance role's credentials can take a moment after boot: wait for them (up to 5 minutes).
ExecStartPre=/usr/bin/timeout 300 /bin/bash -c 'until aws sts get-caller-identity --region us-east-1 >/dev/null 2>&1; do sleep 5; done'
ExecStart=/usr/local/bin/earningswatch-start
ExecStop=/usr/bin/docker compose -p earningswatch -f /opt/earningswatch/deploy/compose.yaml --env-file /run/earningswatch/airflow.env down
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now earningswatch.service
systemctl enable --now earningswatch-backup.timer
echo "bootstrap complete"

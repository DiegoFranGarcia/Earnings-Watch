# Copy to .env and fill in. Never commit .env.
AIRFLOW_UID=
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=
POSTGRES_PASSWORD=

# Sent with every SEC request. Must include a real contact email.
SEC_USER_AGENT=EarningsWatch you@example.com
# The dev data lake bucket: earnings-watch-dev-<account-id>
LAKE_BUCKET=
# The sec_api pool allows 2 tasks at once: 2 x 2.5 = at most 5 requests a second in total.
SEC_RATE_PER_SECOND=2.5
# Spark on EMR Serverless (from: terraform -chdir=infra/envs/dev output)
EMR_APPLICATION_ID=
EMR_JOB_ROLE_ARN=
# Which Spark code to run: s3://<lake-bucket>/artifacts/spark/<commit>, after packaging
SPARK_CODE_URI=
# Snowflake, as SVC_AIRFLOW (role LOADER); the key is mounted by docker-compose.override.yaml
SF_ACCOUNT=
SF_USER=SVC_AIRFLOW
SF_PRIVATE_KEY_PATH=/opt/airflow/keys/svc_airflow_rsa_key.p8
SF_DATABASE=EARNINGSWATCH_DEV
# dbt inside Airflow, as SVC_DBT (role TRANSFORMER); the key is mounted by the override
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/svc_dbt_rsa_key.p8
